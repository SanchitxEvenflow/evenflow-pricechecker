PROXY_FILE=proxies.txt
AMAZON_DELAY_MIN=3.0
AMAZON_DELAY_MAX=7.0
FLIPKART_DELAY_MIN=4.0
FLIPKART_DELAY_MAX=9.0
PLAYWRIGHT_HEADLESS=true
LOG_LEVEL=INFO

# Authentication (all three required to enable; leave blank to disable)
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_SECRET=

# Google Sheets API Service Account Credentials (Base64 encoded JSON)
# Run: base64 -w 0 path/to/service-account.json
GOOGLE_CREDENTIALS_BASE64=

# Cron scheduler — auto-scrape all ASINs on a daily schedule
CRON_ENABLED=false
AMAZON_CRON_HOUR=10             # Hour to run daily Amazon scrape (IST, 0–23)
AMAZON_CRON_MINUTE=0            # Minute offset (0–59)
CRON_SHEET_ID=                  # defaults to SPREADSHEET_ID
CRON_SOURCE_TAB=                # defaults to WORKSHEET_NAME (tab to read ASINs from)
