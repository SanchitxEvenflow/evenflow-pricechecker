# ── Snowpad SOCKS5 Proxy (all scrapers route through this) ───────────────────
# SOCKS5 operates at OSI Layer 5 (lower overhead, no HTTP header fingerprinting).
# Uses socks5h:// to route DNS through the proxy (prevents location leaks).
# Set SNOWPAD_ENABLED=true and fill credentials to activate.
# Falls back to a direct connection if disabled or creds missing.
SNOWPAD_ENABLED=false
SNOWPAD_USER=               # Your Snowpad proxy username
SNOWPAD_PASS=               # Your Snowpad proxy password
SNOWPAD_HOST=gw.snowpad.io
SNOWPAD_PORT=9999
SNOWPAD_MAX_CONCURRENCY=120  # 180-stream plan; keep headroom for retries/manual work
# Pending result writes must live on persistent storage.
SHEETS_OUTBOX_DIR=sheets_outbox
ZEPTO_ITEM_TIMEOUT_SECONDS=240
INSTAMART_ITEM_TIMEOUT_SECONDS=240
# ─────────────────────────────────────────────────────────────────────────────
AMAZON_DELAY_MIN=3.0
AMAZON_DELAY_MAX=7.0
FLIPKART_DELAY_MIN=4.0
FLIPKART_DELAY_MAX=9.0
PLAYWRIGHT_HEADLESS=true
# Starting profile for an 8 GB / 4-core host.
# Shared limit: 8 batch slots, 2 reserved for single-product requests.
SCRAPE_CONCURRENCY=10
MANUAL_RESERVED=2
BROWSER_POOL_SIZE=2
BLINKIT_CONCURRENCY=6
ZEPTO_CITY_CONCURRENCY=3
INSTAMART_CITY_CONCURRENCY=3
LOG_LEVEL=INFO

# Authentication (all three required to enable; leave blank to disable)
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_SECRET=

# Google Sheets API Service Account Credentials (Base64 encoded JSON)
# Run: base64 -w 0 path/to/service-account.json
GOOGLE_CREDENTIALS_BASE64=

# Cron scheduler — auto-scrape all ASINs on a daily schedule
CRON_ENABLED=false
AMAZON_CRON_HOUR=10             # Hour to run daily Amazon scrape (IST, 0–23)
AMAZON_CRON_MINUTE=0            # Minute offset (0–59)
CRON_SHEET_ID=                  # defaults to SPREADSHEET_ID
CRON_SOURCE_TAB=                # defaults to WORKSHEET_NAME (tab to read ASINs from)
FLIPKART_CRON_HOUR=9            # Hour to run daily Flipkart scrape
FLIPKART_CRON_MINUTE=15         # Minute offset
